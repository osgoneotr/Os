# resell-autopilot — copy this to .env and fill in what you have.
# Everything here is OPTIONAL. The toolkit works with none of it set,
# using CSV files and saved eBay pages instead.
#
# .env is git-ignored. Never commit real keys.

# --- eBay API (free, 10 minutes) ---------------------------------------
# developer.ebay.com > sign up > Application Keys > PRODUCTION keyset.
# (The Sandbox keyset returns fake data — make sure you copy Production.)
# Enables: live deal sourcing, automated price comps.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# --- Google Sheets (optional) ------------------------------------------
# Only if you want the ledger in a Sheet rather than a local CSV.
#   1. console.cloud.google.com > new project > enable the Sheets API
#   2. Create a service account, download its JSON key
#   3. Share your Sheet with the service account's email address
#   4. pip install gspread google-auth
# Without this, `make_listings.py --tsv` writes a file you paste in manually,
# which is honestly fine for a few hundred rows.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# --- Debugging ----------------------------------------------------------
# Set to 1 to print full tracebacks when an item fails to price.
AUTOPILOT_DEBUG=
