# --- Supabase (free tier) — required ---
# Get these from supabase.com > your project > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site URL — required for Stripe redirects ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- eBay (free developer account, required for trend comps + eBay cross-post) ---
# Sign up free at developer.ebay.com > create an app > get these from the "Keys" tab
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Only needed to actually publish to eBay (see README "Connecting eBay for real listings")
EBAY_USER_ACCESS_TOKEN=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=

# --- Reddit (free "script" app, optional — trend buzz signal) ---
# Register free at reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- AI listing generation (optional — costs real money per call) ---
# Leave blank to use the free template-based generator instead.
ANTHROPIC_API_KEY=

# --- Stripe (free to integrate, takes a % per transaction — direct in-site sales) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Cron protection (optional but recommended) ---
# Any random string; Vercel Cron sends it automatically as a Bearer token
# once this env var is set on the project.
CRON_SECRET=
