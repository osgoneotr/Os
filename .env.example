# Copy to .env and fill in from https://developers.tiktok.com/ -> your app -> Credentials.
# Never commit the real .env -- these credentials can post to a live account.

TIKTOK_CLIENT_KEY=awxxxxxxxxxxxxxxxx
TIKTOK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Must match a redirect URI registered in the portal, byte for byte.
TIKTOK_REDIRECT_URI=https://localhost:8080/callback

# Where tokens, the queue DB and posting history live.
TIKTOK_STATE_DIR=./.tiktok_state

# Set to 1 to validate the whole flow without uploading anything.
TIKTOK_DRY_RUN=0
